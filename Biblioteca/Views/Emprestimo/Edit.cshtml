@model Biblioteca.ViewModels.EmprestimoViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Editar Emprestimo</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="EmprestimoId" />
            <div class="form-group">
                <label asp-for="DataRetida" class="control-label"></label>
                <input asp-for="DataRetida" class="form-control bg-light text-muted" readonly/>
                <span asp-validation-for="DataRetida" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PrevisaoDevolucao" class="control-label"></label>
                <input asp-for="PrevisaoDevolucao" class="form-control bg-light text-muted" readonly/>
                <span asp-validation-for="PrevisaoDevolucao" class="text-danger"></span>
            </div>
            @if (Model.DataEntregue > DateTime.MinValue)
            {
                <div class="form-group">
                    <label asp-for="DataEntregue" class="control-label"></label>
                    <input asp-for="DataEntregue" class="form-control bg-light text-muted" readonly/>
                    <span asp-validation-for="DataEntregue" class="text-danger"></span>
                </div>
             
                <div class="form-group">
                <label asp-for="Multa" class="control-label"></label>
                <input value="@Model.Multa.ToString("C")" class="form-control bg-light text-muted" readonly/>
                <span asp-validation-for="Multa" class="text-danger"></span>
            </div>
            }
            <div class="form-group">
                <label asp-for="UsuarioId" class="control-label"></label>
                <select asp-for="UsuarioId"
                        asp-items="Model.Usuarios"
                        class="form-select">
                    <option value="">Selecione um leitor</option>
                </select>
                <span asp-validation-for="UsuarioId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FuncionarioId" class="control-label"></label>
                <select asp-for="FuncionarioId"
                        asp-items="Model.Funcionarios"
                        class="form-select">
                    <option value="">Selecione um Colaborador</option>
                </select>
                <span asp-validation-for="FuncionarioId" class="text-danger"></span>
            </div>
           @*  <hr />
           <h4>Cópias</h4>

           <input type="search"
                  id="buscarCopia"
                  class="form-control mb-2"
                  placeholder="Buscar ID da Cópia..." />

            <div class="border rounded p-3"
                 style="max-height: 220px; overflow-y: auto;">

                @foreach (var copia in Model.Copias)
                {
                    <div class="form-check item-copia">
                        <input class="form-check-input"
                               type="checkbox"
                               name="CopiaIds"
                               value="@copia.Value"
                               id="copia_@copia.Value"
                               checked="@Model.CopiaIds.Contains(
                                                   int.Parse(copia.Value!))" />

                        <label class="form-check-label"
                               for="copia_@copia.Value">
                            @copia.Text
                        </label>
                    </div>
                }
            </div> *@
            @* <div class="form-group">
                <label asp-for="Copias" class="control-label"></label>
                <input asp-for="Copias" class="form-control" />
                <span asp-validation-for="Copias" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Usuario" class="control-label"></label>
                <input asp-for="Usuario" class="form-control" />
                <span asp-validation-for="Usuario" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Funcionario" class="control-label"></label>
                <input asp-for="Funcionario" class="form-control" />
                <span asp-validation-for="Funcionario" class="text-danger"></span>
            </div> *@
            <br />
            <div class = "d-flex gap-2">
                <div class="form-group">
                    <input type="submit" value="Salvar" class="btn btn-warning" />
                </div>
                <div>
                    <a href="javascript:history.back()" class="btn btn-primary">Voltar</a>
                </div>
            </div>
        </form>
    </div>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function configurarBusca(campoId, classeItem) {
            const campo = document.getElementById(campoId);

            campo.addEventListener("input", function () {
                const termo = campo.value.toLowerCase();

                document.querySelectorAll("." + classeItem)
                    .forEach(function (item) {
                        const texto = item.textContent.toLowerCase();

                        item.style.display =
                            texto.includes(termo) ? "" : "none";
                    });
            });
        }

        configurarBusca("buscarCopia", "item-copia");
    </script>
}
