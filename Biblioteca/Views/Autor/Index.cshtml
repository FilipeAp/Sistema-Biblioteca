@model IEnumerable<Biblioteca.Models.Autor>

@{
    ViewData["Title"] = "List";
}

<h1>Autores</h1>

<a asp-action="Create" class="btn btn-success btn-sm">
    Registrar Novo Autor
</a>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NomeAutor)
            </th>
            
            <th>
                Qtd. de Livros
            </th>
            <th>Opções</th>
        </tr>
    </thead>
    <tbody>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(model => item.NomeAutor)
            </td>
            <td>
                @Html.DisplayFor(model => item.Livros.Count)
            </td>
            <td>
                <a asp-action="Edit" class="btn btn-warning btn-sm" asp-route-id="@item.AutorId">Editar</a> 
                <a asp-action="Details" class="btn btn-primary btn-sm" asp-route-id="@item.AutorId">Detalhes</a> 
                <a asp-action="Delete" class="btn btn-danger btn-sm" asp-route-id="@item.AutorId">Deletar</a>
            </td>
        </tr>
    }
