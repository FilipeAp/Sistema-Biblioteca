@model Biblioteca.Models.Copia

@{
    ViewData["Title"] = "Details";
}

<h1>Detalhes da Cópia</h1>

<div>

    <hr />
    <dl>
        <dt class = "col-sm-2">
            Livro
        </dt>
        <dd class = "col-sm-10">
            @ViewBag.Livro
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EstadoConservacao)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EstadoConservacao)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Disponivel)
        </dt>
        <dd class = "col-sm-10">
            @(Model.Disponivel ? "✅ Sim" : "❌ Não")
        </dd>
    @* </dl>
        <dt class = "col-sm-2">
            Atualmente com:
        </dt>
        <dd class = "col-sm-10">
            @ViewBag.Emprestimo.
        </dd>
    </dl> *@

</div>
<br />
<div>
    <a asp-action="Edit" class="btn btn-warning" asp-route-id="@Model?.CopiaId">Editar</a> 
    <a href="javascript:history.back()" class="btn btn-primary">Voltar</a>
</div>
