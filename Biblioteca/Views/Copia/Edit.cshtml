@model Biblioteca.Models.Copia

@{
    ViewData["Title"] = "Edit";
}

<h1>Atualizar Cópia</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="CopiaId" />
            <div class="form-group">
                <label asp-for="LivroId" class="control-label">Livro</label>
                <select asp-for="LivroId" class="form-select">
                    <option value="">Selecione um livro</option>
                    @foreach(var livro in ViewBag.Livros)
                    {
                        <option value="@livro.LivroId">@livro.Titulo</option>
                    }
                </select>
                <span asp-validation-for="LivroId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EstadoConservacao" class="control-label"></label>
                <select asp-for="EstadoConservacao" asp-items="Html.GetEnumSelectList<Biblioteca.Models.EstadoConservacao>()" 
                    class="form-select">
                    <option value="">Selecione um estado</option>
                    
                </select>
                <span asp-validation-for="EstadoConservacao" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Disponivel" class="control-label"></label>
                <input asp-for="Disponivel" class="form-check-input" />
                <span asp-validation-for="Disponivel" class="text-danger"></span>
            </div>
            @* <div class="form-group">
                <label asp-for="Livro" class="control-label"></label>
                <input asp-for="Livro" class="form-control" />
                <span asp-validation-for="Livro" class="text-danger"></span>
            </div> *@
            <br />
            <div class = "d-flex gap-2">
                <div class="form-group">
                    <input type="submit" value="Salvar" class="btn btn-warning" />
                </div>
                <div>
                    <a href="javascript:history.back()" asp-action="Index" class="btn btn-primary">Voltar</a>
                </div>
            </div>
        </form>
    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
