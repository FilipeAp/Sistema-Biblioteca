@model Biblioteca.Models.Copia

@{
    ViewData["Title"] = "Deletar Cópia";
}

<h1>Deseja Deletar Essa Cópia?</h1>

<div>

    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CopiaId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CopiaId)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Livro
        </dt>
        <dd class = "col-sm-10">
            @ViewBag.Livro
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EstadoConservacao)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EstadoConservacao)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Disponivel)
        </dt>
        <dd class = "col-sm-10">
            @(Model.Disponivel? "✅Sim" : "❌Não")
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="CopiaId" />
        <input type="submit" value="Deletar" class="btn btn-danger" /> 
        <a href="javascript:history.back()" class="btn btn-primary">Voltar</a>
    </form>
</div>
