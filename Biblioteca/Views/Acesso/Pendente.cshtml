@{
    ViewData["Title"] = "Acesso pendente";
}

<div class="container text-center mt-5">
    <div class="mb-4">
        <i class="bi bi-shield-lock"
           style="font-size: 4rem;"></i>
    </div>

    <h2>Acesso não configurado</h2>

    <p class="text-muted mt-3">
        Não foi possível liberar seu acesso ao sistema.
    </p>

    <p>
        Sua conta está autenticada, mas não possui
        um cadastro associado.
    </p>

    <p>
        Entre em contato com o administrador da biblioteca
        para concluir a configuração do seu acesso.
    </p>

    <form asp-controller="Account"
          asp-action="Logout"
          method="post">
        <button type="submit" class="btn btn-primary mt-3">
            Sair do sistema
        </button>
    </form>
</div>
