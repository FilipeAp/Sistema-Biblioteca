@model IEnumerable<Biblioteca.Models.Usuario>

@{
    ViewData["Title"] = "Leitores";

    var leitores = Model?.ToList() ?? new List<Biblioteca.Models.Usuario>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
}

<div class="lume-page">

    <!-- CABEÇALHO -->
    <section class="lume-page-header">

        <div class="lume-page-heading">

            <span class="lume-page-label">
                <i class="bi bi-people"></i>
                Gestão de leitores
            </span>

            <h1>Leitores</h1>

            <p>
                Gerencie os leitores cadastrados na biblioteca.
            </p>

        </div>

        <a asp-action="Create" class="lume-btn-primary">
            <i class="bi bi-plus-lg"></i>
            Registrar Leitor
        </a>

    </section>


    <!-- LISTAGEM -->
    <section class="lume-list-card">

        <!-- CABEÇALHO DO CARD -->
        <div class="lume-list-header">

            <div class="lume-list-title">
                <i class="bi bi-person-vcard"></i>
                <h2>Leitores cadastrados</h2>
            </div>

            <div class="lume-list-search">
                <i class="bi bi-search"></i>

                <input type="search"
                       id="buscarLeitor"
                       placeholder="Buscar leitor..."
                       autocomplete="off" />
            </div>

        </div>


        <!-- TABELA -->
        <div class="lume-table-responsive">

            <table class="lume-table" id="tabelaLeitores">

                <thead>
                    <tr>

                        <th>
                            <i class="bi bi-person-vcard"></i>
                            CPF
                        </th>

                        <th>
                            <i class="bi bi-person"></i>
                            Nome
                        </th>

                        <th>
                            <i class="bi bi-telephone"></i>
                            Telefone
                        </th>

                        <th>
                            <i class="bi bi-envelope"></i>
                            E-mail
                        </th>

                        <th>
                            <i class="bi bi-gear"></i>
                            Opções
                        </th>

                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in leitores)
                    {
                        <tr class="item-leitor">

                            <td>
                                @Html.DisplayFor(model => item.Cpf)
                            </td>

                            <td>
                                @Html.DisplayFor(model => item.Nome)
                            </td>

                            <td>
                                @Html.DisplayFor(model => item.Telefone)
                            </td>

                            <td>
                                @Html.DisplayFor(model => item.Email)
                            </td>

                            <td>

                                <div class="lume-table-actions">

                                    <a asp-action="Details"
                                       asp-route-id="@item.UsuarioId"
                                       class="lume-btn-action lume-btn-details">

                                        <i class="bi bi-eye"></i>
                                        Detalhes

                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.UsuarioId"
                                       class="lume-btn-action lume-btn-edit">

                                        <i class="bi bi-pencil"></i>
                                        Editar

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.UsuarioId"
                                       class="lume-btn-action lume-btn-delete">

                                        <i class="bi bi-trash"></i>
                                        Deletar

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>


            <!-- ESTADO VAZIO -->
            <div id="leitoresSemResultado"
                 class="lume-empty-state"
                 hidden>

                <i class="bi bi-search"></i>

                <p>Nenhum leitor encontrado.</p>

            </div>

        </div>


        <!-- RODAPÉ -->
        <div class="lume-table-footer">

            <span id="resumoLeitores">
                Mostrando registros
            </span>

            <nav aria-label="Paginação dos leitores">

                <ul id="paginacaoLeitores" class="lume-pagination">
                </ul>

            </nav>

        </div>

    </section>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <!-- BUSCA E PAGINAÇÃO -->
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const campo = document.getElementById("buscarLeitor");

            const linhas = Array.from(
                document.querySelectorAll(".item-leitor")
            );

            const paginacao = document.getElementById("paginacaoLeitores");

            const resumo = document.getElementById("resumoLeitores");

            const mensagem = document.getElementById("leitoresSemResultado");

            const itensPorPagina = 10;

            let paginaAtual = 1;

            let leitoresFiltrados = [...linhas];


            // RENDERIZAR TABELA
            function renderizarTabela() {

                const total = leitoresFiltrados.length;

                const totalPaginas = Math.ceil(total / itensPorPagina);

                paginaAtual = Math.max(
                    1,
                    Math.min(paginaAtual, totalPaginas || 1)
                );


                // Ocultar todas as linhas
                linhas.forEach(linha => {
                    linha.style.display = "none";
                });


                // Calcular registros da página atual
                const inicio = (paginaAtual - 1) * itensPorPagina;

                const fim = Math.min(inicio + itensPorPagina, total);


                // Exibir somente os registros da página
                leitoresFiltrados.slice(inicio, fim).forEach(linha => {
                    linha.style.display = "";
                });


                // Atualizar resumo
                resumo.textContent = total === 0
                    ? "Nenhum registro encontrado"
                    : `Mostrando ${inicio + 1} a ${fim} de ${total} leitores`;


                // Estado vazio
                mensagem.hidden = total !== 0;

                document.getElementById("tabelaLeitores").style.display =
                    total === 0 ? "none" : "table";


                // Atualizar paginação
                renderizarBotoes(totalPaginas);

            }


            // CRIAR BOTÕES DE PAGINAÇÃO
            function adicionarBotao(texto, pagina, desabilitado = false, ativo = false) {

                const li = document.createElement("li");

                const botao = document.createElement("button");

                botao.type = "button";

                botao.textContent = texto;

                botao.disabled = desabilitado;


                if (ativo) {

                    botao.classList.add("active");

                    botao.setAttribute("aria-current", "page");

                }


                botao.addEventListener("click", function () {

                    if (desabilitado) return;

                    paginaAtual = pagina;

                    renderizarTabela();

                });


                li.appendChild(botao);

                paginacao.appendChild(li);

            }


            // RENDERIZAR PAGINAÇÃO
            function renderizarBotoes(totalPaginas) {

                paginacao.innerHTML = "";

                if (totalPaginas <= 1) return;


                // Botão anterior
                adicionarBotao(
                    "‹",
                    paginaAtual - 1,
                    paginaAtual === 1
                );


                // Limitar quantidade de números exibidos
                let inicio = Math.max(1, paginaAtual - 2);

                let fim = Math.min(totalPaginas, inicio + 4);

                inicio = Math.max(1, fim - 4);


                // Números das páginas
                for (let i = inicio; i <= fim; i++) {

                    adicionarBotao(
                        i,
                        i,
                        false,
                        i === paginaAtual
                    );

                }


                // Botão próximo
                adicionarBotao(
                    "›",
                    paginaAtual + 1,
                    paginaAtual === totalPaginas
                );

            }


            // BUSCA DE LEITORES
            campo.addEventListener("input", function () {

                const termo = campo.value
                    .trim()
                    .toLocaleLowerCase("pt-BR");


                leitoresFiltrados = linhas.filter(linha =>

                    linha.textContent
                        .toLocaleLowerCase("pt-BR")
                        .includes(termo)

                );


                // Voltar para a primeira página após pesquisar
                paginaAtual = 1;

                renderizarTabela();

            });


            // INICIALIZAÇÃO
            renderizarTabela();

        });

    </script>

}
