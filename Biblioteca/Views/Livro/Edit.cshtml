@model Biblioteca.ViewModels.LivroViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Atualizar Livro</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="LivroId" />
            <div class="form-group">
                <label asp-for="Titulo" class="control-label"></label>
                <input asp-for="Titulo" class="form-control" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ISBN" class="control-label"></label>
                <input asp-for="ISBN" class="form-control" />
                <span asp-validation-for="ISBN" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Ano_Publicado" class="control-label"></label>
                <input asp-for="Ano_Publicado" class="form-control" />
                <span asp-validation-for="Ano_Publicado" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CategoriaId" class="control-label">Categoria</label>
                <select asp-for="CategoriaId" asp-items="Model.Categorias" class="form-select"> 
                    <option value="">Selecione uma categoria</option>
                </select>
                <span asp-validation-for="CategoriaId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SubcategoriaId" class="control-label">Subcategoria</label>
                <select asp-for="SubcategoriaId" asp-items="Model.Subcategorias" class="form-select"> 
                    <option value="">Selecione uma subcategoria</option>
                </select>
                <span asp-validation-for="SubcategoriaId" class="text-danger"></span>
            </div>
            <hr />
            <h4>Autores</h4>

            <input type="search"
                   id="buscarAutor"
                   class="form-control mb-2"
                   placeholder="Buscar autor..." />

            <div class="border rounded p-3 fundoCheckbox"
                 style="max-height: 220px; overflow-y: auto;">

                @foreach (var autor in Model.Autores)
                {
                    <div class="form-check item-autor">
                        <input class="form-check-input"
                               type="checkbox"
                               name="AutoresIds"
                               value="@autor.Value"
                               id="autor_@autor.Value"
                               checked="@Model.AutoresIds.Contains(
                                                   int.Parse(autor.Value!))" />

                        <label class="form-check-label"
                               for="autor_@autor.Value">
                            @autor.Text
                        </label>
                    </div>
                }
            </div>

            <span asp-validation-for="AutoresIds"
                  class="text-danger"></span>

            <hr />
            <h4>Editoras</h4>

            <input type="search"
                   id="buscarEditora"
                   class="form-control mb-2"
                   placeholder="Buscar editora..." />

            <div class="border rounded p-3 fundoCheckbox"
                 style="max-height: 220px; overflow-y: auto;">

                @foreach (var editora in Model.Editoras)
                {
                    <div class="form-check item-editora">
                        <input class="form-check-input"
                               type="checkbox"
                               name="EditorasIds"
                               value="@editora.Value"
                               id="editora_@editora.Value"
                               checked="@Model.EditorasIds.Contains(
                                                   int.Parse(editora.Value!))" />

                        <label class="form-check-label"
                               for="editora_@editora.Value">
                            @editora.Text
                        </label>
                    </div>
                }
            </div>

            <span asp-validation-for="EditorasIds"
                  class="text-danger"></span>

            <div class="mt-3">
                <button type="submit" class="btn btn-warning">
                    Atualizar
                </button>

                <a href="javascript:history.back()" class="btn btn-primary">
                    Voltar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function configurarBusca(campoId, classeItem) {
            const campo = document.getElementById(campoId);

            campo.addEventListener("input", function () {
                const termo = campo.value.toLowerCase();

                document.querySelectorAll("." + classeItem)
                    .forEach(function (item) {
                        const texto = item.textContent.toLowerCase();

                        item.style.display =
                            texto.includes(termo) ? "" : "none";
                    });
            });
        }

        configurarBusca("buscarAutor", "item-autor");
        configurarBusca("buscarEditora", "item-editora");
    </script>
}