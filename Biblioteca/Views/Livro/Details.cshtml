@model Biblioteca.Models.Livro

@{
    ViewData["Title"] = "Details";
}

<h1>Detalhes do Livro</h1>

<div>
    <hr />
    <dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Titulo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Titulo)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ISBN)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ISBN)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Ano_Publicado)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Ano_Publicado)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Categoria.NomeCategoria)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Categoria.NomeCategoria)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Subcategoria.NomeSubcategoria)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Subcategoria.NomeSubcategoria)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Editoras)
        </dt>
        <dd class = "col-sm-10">
            @foreach(var editora in Model.Editoras)
            {
                @editora.NomeEditora
            }
        </dd>
    </dl>
    @*     <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Copias)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Copias)
        </dd>
    </dl> *@
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Autores)
        </dt>
        <dd class = "col-sm-10">
            @foreach(var autor in Model.Autores)
            {
                @autor.NomeAutor
                <br/>
            }
        </dd>
        @if(Model.Copias.Count(c => c.Disponivel) != Model.Copias.Count){
            <dt class = "col-sm-2">
                Empresimos
            </dt>
            @* <dd class = "col-sm-10">
            @{
                var emprestimos = (IEnumerable<Emprestimo>)ViewBag.Emprestimo;
            }
            @foreach (var emprestimo in emprestimos.Where(e => e.DataEntregue == null)
                 .Where(e => e.Copias.Any(c =>
                 Model.Copias.Any(lc => lc.CopiaId == c.CopiaId)))){

                    var copiaEmprestada = $"{emprestimo.CopiaId} - Previsão de devolução: {emprestimo.PrevisaoDevolucao}";
                     <p>@copiaEmprestada</p>
                }
            </dd> *@
            <dd class="col-sm-10">
        @{
                var emprestimos = (IEnumerable<Emprestimo>)ViewBag.Emprestimo;
                
                }

                @foreach (var emprestimo in emprestimos
                    .Where(e => e.DataEntregue == null))
                {
                    var copiasDoLivro = emprestimo.Copias
                        .Where(c => Model.Copias.Any(lc => lc.CopiaId == c.CopiaId));

                    foreach (var copia in copiasDoLivro)
                    {
                        <p>
                            Cópia: @copia.CopiaId
                            - Previsão de devolução:
                            @emprestimo.PrevisaoDevolucao.ToString("dd/MM/yyyy")
                            <a asp-controller="Emprestimo" asp-action="Details" asp-route-id="@emprestimo.EmprestimoId" class="btn btn-primary btn-sm">Ver Emprestimo associado</a>
                        </p>
                    }
                }
            </dd>
        }
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.LivroId" class="btn btn-warning">Editar</a> 
    <a href="javascript:history.back()" class="btn btn-primary">Voltar</a>
</div>
