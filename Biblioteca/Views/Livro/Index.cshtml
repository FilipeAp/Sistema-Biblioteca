@model IEnumerable<Biblioteca.Models.Livro>

@{
    ViewData["Title"] = "Index";
}
<div class="d-flex justify-content-between align-items-end">
    <div>
        <h1>Livros</h1>

        <a asp-action="Create" class="btn btn-success btn-sm">
            Registrar Novo Livro
        </a>
    </div>
    <form class="d-flex flex-row align-items-center">
    <input type="search"
           id="buscarLivro"
           class="form-control"
           placeholder="Buscar livro..." />
    </form>
</div>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Titulo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ISBN)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ano_Publicado)
            </th>
            <th>
                Copias
            </th>
            <th>
                Disponibilidade
            </th>
            @* <th>
                @Html.DisplayNameFor(model => model.CategoriaId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SubcategoriaId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Categoria)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Subcategoria)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Editoras)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Autores)
            </th> *@
            <th>Opções</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr class="item-livro">
            <td>
                @Html.DisplayFor(model => item.Titulo)
            </td>
            <td>
                @Html.DisplayFor(model => item.ISBN)
            </td>
            <td>
                @Html.DisplayFor(model => item.Ano_Publicado)
            </td>
            <td>
                @item.Copias.Count(c => c.Disponivel) / @item.Copias.Count
            </td>
            <td>
                @if(item.Copias.Count(c => c.Disponivel) > 0){
                        <div class="badge bg-success" role="alert">
                        Disponível
                    </div>
                }else{
                        <div class="badge bg-danger" role="alert">
                        Indisponível
                    </div>
                }
            </td>
            @* <td>
                @Html.DisplayFor(model => item.CategoriaId)
            </td>
            <td>
                @Html.DisplayFor(model => item.SubcategoriaId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Categoria)
            </td>
            <td>
                @Html.DisplayFor(model => item.Subcategoria)
            </td>
            <td>
                @Html.DisplayFor(model => item.Editoras)
            </td>
            <td>
                @Html.DisplayFor(model => item.Autores)
            </td> *@
            <td>
                <a asp-action="Edit" class="btn btn-warning btn-sm" asp-route-id="@item.LivroId">Editar</a> 
                <a asp-action="Details" class="btn btn-primary btn-sm" asp-route-id="@item.LivroId">Detalhes</a> 
                <a asp-action="Delete" class="btn btn-danger btn-sm" asp-route-id="@item.LivroId">Deletar</a>
            </td>
        </tr>
}
    </tbody>
</table>
<nav aria-label="Paginação dos livros">
    <ul id="paginacaoLivros"
        class="pagination justify-content-center mt-4">
    </ul>
</nav>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const campo = document.getElementById("buscarLivro");
            const linhas = Array.from(
                document.querySelectorAll(".item-livro")
            );
            const paginacao = document.getElementById("paginacaoLivros");

            const itensPorPagina = 10;
            let paginaAtual = 1;
            let livrosFiltrados = [...linhas];

            function renderizarTabela() {
                const totalPaginas = Math.ceil(
                    livrosFiltrados.length / itensPorPagina
                );

                // Garante que a página atual continue válida após uma busca.
                paginaAtual = Math.max(
                    1,
                    Math.min(paginaAtual, totalPaginas || 1)
                );

                // Esconde todas as linhas inicialmente.
                linhas.forEach(linha => {
                    linha.style.display = "none";
                });

                // Calcula quais livros devem aparecer nesta página.
                const inicio = (paginaAtual - 1) * itensPorPagina;
                const fim = inicio + itensPorPagina;

                livrosFiltrados.slice(inicio, fim).forEach(linha => {
                    linha.style.display = "";
                });

                renderizarBotoes(totalPaginas);
            }

            function renderizarBotoes(totalPaginas) {
                paginacao.innerHTML = "";

                if (totalPaginas <= 1) {
                    return;
                }

                function adicionarBotao(texto, pagina, desabilitado = false,
                    ativo = false) {
                    const li = document.createElement("li");
                    li.className = "page-item";

                    if (desabilitado) li.classList.add("disabled");
                    if (ativo) li.classList.add("active");

                    const botao = document.createElement("button");
                    botao.type = "button";
                    botao.className = "page-link";
                    botao.textContent = texto;
                    botao.disabled = desabilitado;

                    botao.addEventListener("click", function() {
                        paginaAtual = pagina;
                        renderizarTabela();
                    });

                    li.appendChild(botao);
                    paginacao.appendChild(li);
                }

                // Botão anterior.
                adicionarBotao(
                    "‹",
                    paginaAtual - 1,
                    paginaAtual === 1
                );

                // Mostra até 5 números de página.
                let inicio = Math.max(1, paginaAtual - 2);
                let fim = Math.min(totalPaginas, inicio + 4);

                // Mantém até 5 números também nas últimas páginas.
                inicio = Math.max(1, fim - 4);

                for (let i = inicio; i <= fim; i++) {
                    adicionarBotao(
                        i,
                        i,
                        false,
                        i === paginaAtual
                    );
                }

                // Botão próximo.
                adicionarBotao(
                    "›",
                    paginaAtual + 1,
                    paginaAtual === totalPaginas
                );
            }

            campo.addEventListener("input", function() {
                const termo = campo.value
                    .trim()
                    .toLocaleLowerCase();

                livrosFiltrados = linhas.filter(linha =>
                    linha.textContent
                        .toLocaleLowerCase()
                        .includes(termo)
                );

                // Ao buscar, volta para a primeira página.
                paginaAtual = 1;
                renderizarTabela();
            });

            renderizarTabela();
        });

        
    </script>
}
