@model Biblioteca.Models.Livro

@{
    ViewData["Title"] = "Deletar Livro";
}

<h1>Deseja deletar esse Livro?</h1>


<div>

    <hr />
    <dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Titulo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Titulo)
        </dd>
    </dl>
    <dl >
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ISBN)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ISBN)
        </dd>
    </dl>
    <dl >
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Ano_Publicado)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Ano_Publicado)
        </dd>
    </dl>
    <dl >
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Categoria.NomeCategoria)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Categoria.NomeCategoria)
        </dd>
    </dl>
    <dl >
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Subcategoria.NomeSubcategoria)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Subcategoria.NomeSubcategoria)
        </dd>
    </dl>
    <dl >
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Editoras)
        </dt>
        <dd class = "col-sm-10">
            @foreach (var editora in Model.Editoras)
            {
                @editora.NomeEditora
            }
        </dd>
    </dl>
    @* <dl >
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Copias)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Copias)
        </dd>
    </dl> *@
    <dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Autores)
        </dt>
        <dd class = "col-sm-10">
            @foreach (var autor in Model.Autores)
            {
                @autor.NomeAutor
                <br />
            }
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="LivroId" />
        <input type="submit" value="Deletar" class="btn btn-danger" /> 
        <a href="javascript:history.back()" class="btn btn-primary">Voltar</a>
    </form>
</div>
