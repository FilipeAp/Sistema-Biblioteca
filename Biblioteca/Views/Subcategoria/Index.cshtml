@model IEnumerable<Biblioteca.Models.Subcategoria>

@{
    ViewData["Title"] = "Subcategorias";

    var subcategorias = Model?.ToList() ?? new List<Biblioteca.Models.Subcategoria>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
}

<div class="lume-page">

    <!-- CABEÇALHO -->
    <section class="lume-page-header">

        <div class="lume-page-heading">

            <span class="lume-page-label">
                <i class="bi bi-bookmark"></i>
                Organização do acervo
            </span>

            <h1>Subcategorias</h1>

            <p>
                Gerencie as subcategorias utilizadas para organizar os livros da biblioteca.
            </p>

        </div>

        <a asp-action="Create" class="lume-btn-primary">
            <i class="bi bi-plus-lg"></i>
            Registrar Subcategoria
        </a>

    </section>


    <!-- LISTAGEM -->
    <section class="lume-list-card">

        <!-- CABEÇALHO DO CARD -->
        <div class="lume-list-header">

            <div class="lume-list-title">
                <i class="bi bi-bookmarks"></i>
                <h2>Subcategorias cadastradas</h2>
            </div>

            <div class="lume-list-search">
                <i class="bi bi-search"></i>

                <input type="search"
                       id="buscarSubcategoria"
                       placeholder="Buscar subcategoria..."
                       autocomplete="off" />
            </div>

        </div>


        <!-- TABELA -->
        <div class="lume-table-responsive">

            <table class="lume-table">

                <thead>
                    <tr>

                        <th>
                            <i class="bi bi-bookmark"></i>
                            Nome da subcategoria
                        </th>

                        <th>
                            <i class="bi bi-gear"></i>
                            Opções
                        </th>

                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in subcategorias)
                    {
                        <tr class="item-subcategoria">

                            <td>
                                @Html.DisplayFor(model => item.NomeSubcategoria)
                            </td>

                            <td>

                                <div class="lume-table-actions">

                                    <a asp-action="Details"
                                       asp-route-id="@item.SubcategoriaId"
                                       class="lume-btn-action lume-btn-details">

                                        <i class="bi bi-eye"></i>
                                        Detalhes

                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.SubcategoriaId"
                                       class="lume-btn-action lume-btn-edit">

                                        <i class="bi bi-pencil"></i>
                                        Editar

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.SubcategoriaId"
                                       class="lume-btn-action lume-btn-delete">

                                        <i class="bi bi-trash"></i>
                                        Deletar

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>


            <!-- ESTADO VAZIO -->
            <div id="mensagemSemResultados"
                 class="lume-empty-state"
                 hidden>

                <i class="bi bi-search"></i>

                <p>Nenhuma subcategoria encontrada.</p>

            </div>

        </div>


        <!-- RODAPÉ -->
        <div class="lume-table-footer">

            <span id="resumoRegistros">
                Mostrando registros
            </span>

            <nav aria-label="Paginação das subcategorias">

                <ul id="paginacaoSubcategorias" class="lume-pagination">
                </ul>

            </nav>

        </div>

    </section>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <!-- BUSCA E PAGINAÇÃO -->
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const campo = document.getElementById("buscarSubcategoria");

            const linhas = Array.from(
                document.querySelectorAll(".item-subcategoria")
            );

            const paginacao = document.getElementById("paginacaoSubcategorias");

            const resumo = document.getElementById("resumoRegistros");

            const mensagem = document.getElementById("mensagemSemResultados");

            const itensPorPagina = 10;

            let paginaAtual = 1;

            let subcategoriasFiltradas = [...linhas];


            // RENDERIZAR TABELA
            function renderizarTabela() {

                const total = subcategoriasFiltradas.length;

                const totalPaginas = Math.ceil(total / itensPorPagina);

                paginaAtual = Math.max(
                    1,
                    Math.min(paginaAtual, totalPaginas || 1)
                );


                // Ocultar todas as linhas
                linhas.forEach(linha => {
                    linha.style.display = "none";
                });


                // Calcular registros da página atual
                const inicio = (paginaAtual - 1) * itensPorPagina;

                const fim = Math.min(inicio + itensPorPagina, total);


                // Exibir registros da página atual
                subcategoriasFiltradas.slice(inicio, fim).forEach(linha => {
                    linha.style.display = "";
                });


                // Atualizar resumo
                resumo.textContent = total === 0
                    ? "Nenhum registro encontrado"
                    : `Mostrando ${inicio + 1} a ${fim} de ${total} registros`;


                // Estado vazio
                mensagem.hidden = total !== 0;


                // Atualizar paginação
                renderizarBotoes(totalPaginas);

            }


            // CRIAR BOTÕES
            function adicionarBotao(texto, pagina, desabilitado = false, ativo = false) {

                const li = document.createElement("li");

                const botao = document.createElement("button");

                botao.type = "button";

                botao.textContent = texto;

                botao.disabled = desabilitado;


                if (ativo) {

                    botao.classList.add("active");

                    botao.setAttribute("aria-current", "page");

                }


                botao.addEventListener("click", function () {

                    if (desabilitado) return;

                    paginaAtual = pagina;

                    renderizarTabela();

                });


                li.appendChild(botao);

                paginacao.appendChild(li);

            }


            // RENDERIZAR PAGINAÇÃO
            function renderizarBotoes(totalPaginas) {

                paginacao.innerHTML = "";

                if (totalPaginas <= 1) return;


                // Página anterior
                adicionarBotao(
                    "‹",
                    paginaAtual - 1,
                    paginaAtual === 1
                );


                // Números das páginas
                let inicio = Math.max(1, paginaAtual - 2);

                let fim = Math.min(totalPaginas, inicio + 4);

                inicio = Math.max(1, fim - 4);


                for (let i = inicio; i <= fim; i++) {

                    adicionarBotao(
                        i,
                        i,
                        false,
                        i === paginaAtual
                    );

                }


                // Próxima página
                adicionarBotao(
                    "›",
                    paginaAtual + 1,
                    paginaAtual === totalPaginas
                );

            }


            // BUSCA
            campo.addEventListener("input", function () {

                const termo = campo.value
                    .trim()
                    .toLocaleLowerCase("pt-BR");


                subcategoriasFiltradas = linhas.filter(linha =>

                    linha.textContent
                        .toLocaleLowerCase("pt-BR")
                        .includes(termo)

                );


                // Reiniciar paginação
                paginaAtual = 1;

                renderizarTabela();

            });


            // INICIALIZAÇÃO
            renderizarTabela();

        });

    </script>

}
