@model IEnumerable<Biblioteca.Models.Subcategoria>

@{
    ViewData["Title"] = "Index";
}

<h1>Subcategorias</h1>

<a asp-action="Create" class="btn btn-success btn-sm">
    Registrar Nova Subcategoria
</a>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NomeSubcategoria)
            </th>
            @* <th>
                @Html.DisplayNameFor(model => model.Livros)
            </th> *@
            <th>Opções</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.NomeSubcategoria)
            </td>
            @* <td>
                @Html.DisplayFor(model => item.Livros)
            </td> *@
            <td>
                <a asp-action="Edit" class="btn btn-warning btn-sm" asp-route-id="@item.SubcategoriaId">Editar</a> 
                <a asp-action="Details" class="btn btn-primary btn-sm" asp-route-id="@item.SubcategoriaId">Detalhes</a> 
                <a asp-action="Delete" class="btn btn-danger btn-sm" asp-route-id="@item.SubcategoriaId">Deletar</a>
            </td>
        </tr>
}
    </tbody>
</table>
